# NJ Transit developer credentials.
#
# Register at https://developer.njtransit.com/registration/ — NJ Transit issues a
# USERNAME and PASSWORD, not an API key. The server exchanges them for a token on
# each start via POST /api/BUSDV2/authenticateUser.
#
# Leave these blank and the app serves a clearly-labelled sample board instead.
NJT_USERNAME=
NJT_PASSWORD=

# "test" points at testpcsdata.njtransit.com; anything else uses production.
NJT_ENV=prod

# Port the API proxy listens on. Caddy reverse-proxies /api/* here.
PORT=3057
HOST=127.0.0.1

# How long a board is reused before refetching upstream. 20s keeps gate changes
# fresh while costing ~4.3k upstream calls/day against NJ Transit's 40k limit.
DEPARTURES_TTL_MS=20000

# Safety net so a runaway client can't burn the account's daily quota.
NJT_DAILY_CALL_CAP=30000

# DepartureVision stop id for Port Authority Bus Terminal. The seeded default is
# unverified — run `curl localhost:3057/api/stops/verify` once credentials are in
# place, and set the confirmed id here.
PABT_STOP_ID=
