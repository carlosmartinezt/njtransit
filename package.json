{
  "name": "njtransit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Which bus, which gate, how long \u2014 a departure board for Port Authority.",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"node --watch server/dev.mjs\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/dev.mjs",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "stops": "node scripts/refresh-stops.mjs",
    "routes": "node scripts/refresh-routes.mjs",
    "dev:vercel": "vercel dev",
    "deploy": "./ops/deploy.sh",
    "import:gates": "node scripts/import-gate-history.mjs"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.4",
    "preact": "^10.24.3"
  },
  "devDependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.1.1",
    "@fontsource/ibm-plex-sans-condensed": "^5.1.0",
    "@preact/preset-vite": "^2.9.1",
    "concurrently": "^9.1.0",
    "playwright-core": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.0"
  }
}
