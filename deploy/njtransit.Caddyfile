# Caddy site block for njtransit.carlosmartinezt.com
#
# Append to /etc/caddy/Caddyfile, then: sudo systemctl reload caddy
#
# Same pattern as journal.carlosmartinezt.com: Caddy serves the built SPA
# straight out of the repo's dist/, so `npm run build` is the deploy. The one
# addition is /api/*, which proxies to the credential-holding Node service
# (njtransit-api.service) — NJ Transit's API has no CORS and the credentials
# must never reach the browser.

njtransit.carlosmartinezt.com {
    encode gzip zstd

    handle /api/* {
        reverse_proxy 127.0.0.1:3057
    }

    handle {
        root * /home/carlos/njtransit/dist

        # Everything the page needs is same-origin: fonts are self-hosted and
        # the only network call is /api on this host. So the CSP can be strict
        # enough that an injected script has nowhere to send anything.
        header {
            Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
            Strict-Transport-Security "max-age=31536000; includeSubDomains"
            X-Content-Type-Options "nosniff"
            Referrer-Policy "strict-origin-when-cross-origin"
            X-Frame-Options "DENY"
        }

        # The shell and service worker must never be held by a cache, so a new
        # build reaches the phone on the next load.
        @noCache path /sw.js /index.html /manifest.webmanifest /registerSW.js
        header @noCache Cache-Control "no-cache, no-store, must-revalidate"

        # Fingerprinted assets are immutable.
        @assets path /assets/*
        header @assets Cache-Control "public, max-age=31536000, immutable"

        # {path}/index.html before the SPA fallback, or the prerendered route
        # pages under /bus/166/ are shadowed by the home page and every search
        # result gets the same title. Verified: without the middle entry Caddy
        # answers /bus/166 with dist/index.html.
        try_files {path} {path}/index.html /index.html
        file_server
    }
}
